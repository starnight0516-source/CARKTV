<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mediaPane"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="fit"
                app:use_controller="true" />

            <TextView
                android:id="@+id/tvQualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="#99000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="HD"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/playerView"
                app:layout_constraintTop_toTopOf="@id/playerView" />

            <LinearLayout
                android:id="@+id/audioOnlyOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#0A0C10"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/playerView"
                app:layout_constraintEnd_toEndOf="@id/playerView"
                app:layout_constraintStart_toStartOf="@id/playerView"
                app:layout_constraintTop_toTopOf="@id/playerView">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="純聽歌護眼模式"
                    android:textColor="#00B0FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioOnlyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="啟動自動連播中..."
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/playerView"
                app:layout_constraintEnd_toEndOf="@id/playerView"
                app:layout_constraintStart_toStartOf="@id/playerView"
                app:layout_constraintTop_toTopOf="@id/playerView" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161920"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:text="🎵 啟動中，即將自動連續播放..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQrCode"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:backgroundTint="#6A1B9A"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="9dp"
                    android:text="📱 掃碼"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoPlayMode"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#283593"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="公播:混合"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateCatalog"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1B5E20"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="更新歌單"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#37474F"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="⏮ 上首"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FF6D00"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="下首 ⏭"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplay"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="0.8"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="重唱"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchSource"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="0.9"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="換版本"
                    android:textColor="#40E0FF"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudioOnly"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="0.9"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="純聽歌"
                    android:textColor="#FFD54F"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="0.85"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:text="全螢幕"
                    android:textColor="#A5D6A7"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/catalogPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101319"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#1E232D"
                android:hint="輸入歌名或歌手搜尋（江蕙、周杰倫、伍佰）"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8892A0"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00B0FF"
                android:focusable="true"
                android:text="搜歌"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101319"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabHot"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#FF6D00"
                    android:focusable="true"
                    android:text="新歌排行"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabKkZh"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="KK華語榜"
                    android:textColor="#00E5FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabKkTw"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="KK台語榜"
                    android:textColor="#FF80AB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabTaiwanese"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="台語金曲"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabMandarin"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="國語熱門"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabClassics"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="經典對唱"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabSingers"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="歌星點歌"
                    android:textColor="#40E0FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabWordCount"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="字數分類"
                    android:textColor="#A5D6A7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:backgroundTint="#232833"
                    android:focusable="true"
                    android:text="已點 (0)"
                    android:textColor="#FFD54F"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/kkboxSubBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151922"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKkSongDaily"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#00B0FF"
                android:focusable="true"
                android:text="🔥 單曲日榜 Top 50"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKkNewDaily"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#252B37"
                android:focusable="true"
                android:text="✨ 新歌日榜 Top 50"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/wordCountBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151922"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWcAll"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#00B0FF"
                    android:focusable="true"
                    android:text="全部"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc1"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="1字"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc2"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="2字"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc3"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="3字"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc4"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="4字"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc5"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="5字"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWc6Plus"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:backgroundTint="#252B37"
                    android:focusable="true"
                    android:text="6字以上"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/singerHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151922"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToSingers"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#2B3240"
                android:focusable="true"
                android:text="← 返回歌星列表"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSelectedSinger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="歌星名稱"
                android:textColor="#40E0FF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCatalog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F1115"
                android:clipToPadding="false"
                android:padding="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSingers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F1115"
                android:clipToPadding="false"
                android:padding="10dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQueue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F1115"
                android:clipToPadding="false"
                android:padding="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listLoadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#AA0F1115"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="42dp"
                    android:layout_height="42dp" />

                <TextView
                    android:id="@+id/tvListLoadingMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="正在載入歌單..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
