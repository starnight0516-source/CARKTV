<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical">

    <!-- 上半部：MV 播放區 (固定 16:9 比例) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:resize_mode="fit"
            app:use_controller="true" />

        <!-- 純聽歌遮罩 (夜間護眼模式) -->
        <LinearLayout
            android:id="@+id/audioOnlyOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#0A0C10"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/playerView"
            app:layout_constraintEnd_toEndOf="@id/playerView"
            app:layout_constraintStart_toStartOf="@id/playerView"
            app:layout_constraintTop_toTopOf="@id/playerView">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="純聽歌護眼模式"
                android:textColor="#00B0FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioOnlyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="啟動自動連播中..."
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 載入中提示 -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/playerView"
            app:layout_constraintEnd_toEndOf="@id/playerView"
            app:layout_constraintStart_toStartOf="@id/playerView"
            app:layout_constraintTop_toTopOf="@id/playerView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 播放資訊與快捷大按鈕列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161920"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="🎵 啟動中，即將自動連續播放..."
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FF6D00"
                android:text="切歌"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplay"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#232833"
                android:text="重唱"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchSource"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:backgroundTint="#232833"
                android:text="換版本"
                android:textColor="#40E0FF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioOnly"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:backgroundTint="#232833"
                android:text="純聽歌"
                android:textColor="#FFD54F"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 搜尋列（原生搜尋，零廣告） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101319"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="#1E232D"
            android:hint="輸入歌名或歌手搜尋（例如：江蕙、周杰倫、伍佰）"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8892A0"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00B0FF"
            android:text="搜歌"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 主分類分頁列 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101319"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabHot"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FF6D00"
                android:text="新歌排行"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabTaiwanese"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#232833"
                android:text="台語金曲"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabMandarin"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#232833"
                android:text="國語熱門"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabClassics"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#232833"
                android:text="經典對唱"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSingers"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#232833"
                android:text="歌星點歌"
                android:textColor="#40E0FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabWordCount"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#232833"
                android:text="字數分類"
                android:textColor="#A5D6A7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabQueue"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:backgroundTint="#232833"
                android:text="已點 (0)"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 字數分類次選單（點選「字數分類」時顯示） -->
    <HorizontalScrollView
        android:id="@+id/wordCountBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151922"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWcAll"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#00B0FF"
                android:text="全部"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc1"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#252B37"
                android:text="1字"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc2"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#252B37"
                android:text="2字"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc3"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#252B37"
                android:text="3字"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc4"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#252B37"
                android:text="4字"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc5"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#252B37"
                android:text="5字"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWc6Plus"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#252B37"
                android:text="6字以上"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 歌星詳情返回列（點進某位歌星時顯示） -->
    <LinearLayout
        android:id="@+id/singerHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151922"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToSingers"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#2B3240"
            android:text="← 返回歌星列表"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedSinger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="歌星名稱"
            android:textColor="#40E0FF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 下半部：100% 純原生點歌清單 / 歌星牆 / 已點歌單 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1115"
            android:clipToPadding="false"
            android:padding="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSingers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1115"
            android:clipToPadding="false"
            android:padding="10dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQueue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1115"
            android:clipToPadding="false"
            android:padding="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AA0F1115"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <TextView
                android:id="@+id/tvListLoadingMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="正在載入歌單..."
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
